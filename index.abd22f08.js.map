"use strict";
var largeImg = document.querySelector(".gallery__large-img");
var thumbsContainer = document.querySelector(".gallery__list");
thumbsContainer.addEventListener("click", function(e) {
    e.preventDefault();
    var link = e.target.closest(".list-item__link");
    if (!link) return;
    largeImg.setAttribute("src", link.href);
});

